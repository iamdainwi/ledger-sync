data/output/*
!data/output/.gitkeep
backend/data/output/*
!backend/data/output/.gitkeep

# Preserve baseline test fixtures
!backend/data/input/transactions.csv
!backend/data/input/settlement.csv
!backend/data/input/.gitkeep
!data/input/transactions.csv
!data/input/settlement.csv
!data/input/.gitkeep

